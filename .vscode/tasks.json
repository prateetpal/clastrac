			"args": [
				"-e",
				"const fs=require(\"node:fs\"); const dns=require(\"node:dns\").promises; const mongoose=require(\"mongoose\"); const line=fs.readFileSync(\".env\",\"utf8\").split(/\\r?\\n/).find(x=>x.startsWith(\"MONGODB_URI=\")); const raw=line?line.slice(\"MONGODB_URI=\".length).trim().replace(/^['\"]|['\"]$/g,\"\"):\"\"; if(!raw){console.log(\"MONGODB_URI missing\");process.exit(1)} let uri; try{uri=new URL(raw)}catch{console.log(\"MONGODB_URI format invalid\");process.exit(1)} console.log(\"URI scheme:\",uri.protocol); dns.resolveSrv(\"_mongodb._tcp.\"+uri.hostname).then(records=>console.log(\"SRV records:\",records.length)).catch(error=>console.log(\"SRV lookup error:\",error.code||error.name)); (async()=>{try{await mongoose.connect(raw,{serverSelectionTimeoutMS:8000});await mongoose.connection.db.admin().ping();console.log(\"MongoDB ping: connected\")}catch(error){console.log(\"MongoDB connection error:\",error.code||error.name)}finally{await mongoose.disconnect().catch(()=>{})}})();"
			]
		},
		{
			"label": "MongoDB connectivity check",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const fs=require(\"node:fs\"); const dns=require(\"node:dns\").promises; const mongoose=require(\"mongoose\"); const line=fs.readFileSync(\".env\",\"utf8\").split(/\\r?\\n/).find(x=>x.startsWith(\"MONGODB_URI=\")); let raw=line?line.slice(\"MONGODB_URI=\".length).trim():\"\"; if(raw.charCodeAt(0)===34||raw.charCodeAt(0)===39)raw=raw.slice(1,-1); if(!raw){console.log(\"MONGODB_URI missing\");process.exit(1)} let uri; try{uri=new URL(raw)}catch{console.log(\"MONGODB_URI format invalid\");process.exit(1)} console.log(\"URI scheme:\",uri.protocol); dns.resolveSrv(\"_mongodb._tcp.\"+uri.hostname).then(records=>console.log(\"SRV records:\",records.length)).catch(error=>console.log(\"SRV lookup error:\",error.code||error.name)); (async()=>{try{await mongoose.connect(raw,{serverSelectionTimeoutMS:8000});await mongoose.connection.db.admin().ping();console.log(\"MongoDB ping: connected\")}catch(error){console.log(\"MongoDB connection error:\",error.code||error.name)}finally{await mongoose.disconnect().catch(()=>{})}})();"
			]
